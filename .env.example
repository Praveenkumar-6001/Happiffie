NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

# Use DATABASE_URL for the application runtime.
# For Supabase this can be the pooled connection URL.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/happiffie

# Use DIRECT_URL for Prisma migrations.
# For Supabase use the direct/session connection URL, not the transaction pooler URL.
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/happiffie
REDIS_URL=redis://localhost:6379

JWT_SECRET=replace-with-at-least-32-characters
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace-with-refresh-secret
JWT_REFRESH_EXPIRES_IN=7d

OPENAI_API_KEY=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
AWS_REGION=ap-south-1
AWS_S3_BUCKET=happiffie-assets
FIREBASE_PROJECT_ID=
